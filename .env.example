# ─── Envío de facturas por correo (OPCIONAL — apagado por defecto) ───────────
# Sin estas variables, el envío por correo queda inactivo: el botón no aparece y
# el endpoint /api/facturas/[id]/enviar responde 503. Para activarlo:
#   1) Crear cuenta en https://resend.com y verificar un dominio de envío.
#   2) Definir estas variables en Vercel (scope Production) y redesplegar.
#   3) Aplicar la migración supabase/migrations/20260730_invoice_email.sql
#      (auditoría de envíos; opcional pero recomendado).

# Clave del API de Resend
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Remitente verificado (nombre + correo del dominio verificado en Resend)
EMAIL_FROM="Advance Truck Repair <facturas@tudominio.com>"
# Interruptor maestro del backend (opcional; "false" apaga aunque haya API key)
EMAIL_ENABLED=true
# Muestra el botón "Enviar por correo" en la app (debe ser público)
NEXT_PUBLIC_EMAIL_ENABLED=true
